# Keep source and documentation deterministic across Windows/Linux checkouts.
* text=auto
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.bib text eol=lf
*.cff text eol=lf
*.diff text eol=lf
*.tex text eol=lf
research/publications/**/SHA256SUMS.txt text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.svg text eol=lf
*.b5d binary
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
# GitHub stores existing binary artifacts as immutable regular Git blobs.
# LFS conversion is confined to the disposable Hugging Face mirror.
*.json.gz binary
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.whl binary
*.docx binary
*.ckpt binary

# These four existing LFS objects retain their current storage contract.
artifacts/benchmark_ladder_neuron_synapse.json filter=lfs diff=lfs merge=lfs -text
docs/06-research/Brain-5D_Scientific_Framework_v0.2.docx filter=lfs diff=lfs merge=lfs -text
docs/06-research/KI_Die_geliehene_Intelligenz_Dissertation.docx filter=lfs diff=lfs merge=lfs -text
docs/06-research/KI_Die_geliehene_Intelligenz_Kontrollverlust_Embodiment_Dissertationsbasis.docx filter=lfs diff=lfs merge=lfs -text

# Two trailing spaces encode intentional Markdown hard line breaks.
research/publications/reader/*.md whitespace=-blank-at-eol
research/publications/2026-09-07_ki-die-geliehene-intelligenz_v1.1/*.md whitespace=-blank-at-eol
