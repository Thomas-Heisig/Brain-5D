+* text=auto
+*.py text eol=lf
+*.toml text eol=lf
+*.yaml text eol=lf
+*.yml text eol=lf
+*.md text eol=lf
+*.json text eol=lf
+*.diff text eol=lf
+*.ps1 text eol=crlf
+*.bat text eol=crlf
+*.cmd text eol=crlf
+*.svg text eol=lf
+*.b5d binary
+# ============================================================================
+# Git LFS — required for Hugging Face repository
+# Large binary files are stored via Git LFS to keep the repository lean.
+# ============================================================================
+# Simulation snapshots and journals (binary format)
+*.b5d filter=lfs diff=lfs merge=lfs -text
+*.b5d.journal filter=lfs diff=lfs merge=lfs -text
+# Checkpoint files
+*.ckpt filter=lfs diff=lfs merge=lfs -text
+# Large data artifacts
+artifacts/** filter=lfs diff=lfs merge=lfs -text
+# Images, plots, and generated visualizations
+*.png filter=lfs diff=lfs merge=lfs -text
+*.jpg filter=lfs diff=lfs merge=lfs -text
+*.jpeg filter=lfs diff=lfs merge=lfs -text
+*.gif filter=lfs diff=lfs merge=lfs -text
+*.ico filter=lfs diff=lfs merge=lfs -text
+# Compressed experiment traces and WebAssembly assets
+*.json.gz filter=lfs diff=lfs merge=lfs -text
+*.wasm filter=lfs diff=lfs merge=lfs -text
+# Archives and containers
+*.zip filter=lfs diff=lfs merge=lfs -text
+*.tar.gz filter=lfs diff=lfs merge=lfs -text
+*.whl filter=lfs diff=lfs merge=lfs -text
+# Model weights (future use)
+*.pt filter=lfs diff=lfs merge=lfs -text
+*.pth filter=lfs diff=lfs merge=lfs -text
+*.h5 filter=lfs diff=lfs merge=lfs -text
+*.onnx filter=lfs diff=lfs merge=lfs -text
+*.docx filter=lfs diff=lfs merge=lfs -text
