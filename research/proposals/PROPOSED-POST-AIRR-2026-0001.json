    {
      "id": "learning_shared_network_interference_v2",
      "implementation": null,
      "status": "DESIGN_REQUIRED_NOT_EXECUTABLE",
      "question": "Does sequential acquisition on one persistent network reduce previously acquired task performance compared with matched single-task and replay controls?",
      "required_controls": [
