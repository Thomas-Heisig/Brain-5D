  "human_preregistration_required_before_evidence_use": true,
  "rationale": [
    "The 100000-tick run demonstrates finite numerical trajectories and unchanged topology under both registered conditions.",
    "The no-input control is quiescent after burn-in, so numerical stability must be distinguished from sustained active spike dynamics.",
    "The fixed small-network conditions can produce identical trajectories across seed labels; parameter perturbation is required before treating seed-labelled runs as a robustness distribution.",
    "The existing learning_interference_screen_v1 is an independent-task precursor screen and is not a shared-network catastrophic-forgetting test."
  ],
  "proposed_experiments": [
    {
      "id": "snn_drive_response_curve_v1",
      "implementation": "src.research.stability_followups:run_drive_response_curve",
      "status": "EXECUTABLE_EXPLORATORY",
      "question": "At which tonic-drive levels does the model transition from quiescence to stable or variable active spiking while remaining numerically stable?",
      "conditions": ["drive=0", "drive=25", "drive=50", "drive=75", "drive=100"],
      "recommended_seeds": "101-110",
      "recommended_ticks": 20000,
      "primary_outcomes": [
        "numerical_stability_pass",
        "active_dynamics_pass",
        "activity_regime",
        "post_burn_in_mean_spikes",
        "post_burn_in_spike_cv",
        "post_burn_in_spike_relative_drift",
        "active_window_fraction"
      ]
    },
    {
      "id": "snn_stimulus_class_stability_v1",
      "implementation": "src.research.stability_followups:run_stimulus_class_stability",
      "status": "EXECUTABLE_EXPLORATORY",
      "question": "Are long-horizon activity regimes specific to tonic stimulation or robust to temporal and stochastic input structure?",
      "conditions": ["no_input", "tonic", "rhythmic_50_percent_duty", "seeded_bounded_noise"],
      "recommended_seeds": "101-110",
      "recommended_ticks": 20000,
      "primary_outcomes": [
        "activity_regime",
        "post_burn_in_mean_spikes",
        "post_burn_in_spike_cv",
        "post_burn_in_spike_relative_drift",
        "post_burn_in_voltage_relative_drift",
        "active_window_fraction"
      ]
    },
    {
      "id": "snn_parameter_robustness_v1",
      "implementation": "src.research.stability_followups:run_parameter_robustness",
      "status": "EXECUTABLE_EXPLORATORY",
      "question": "Does the observed stable active regime survive small seed-bound perturbations of synaptic weight and drive magnitude?",
      "conditions": ["joint_drive_and_weight_jitter_plus_minus_5_percent"],
      "recommended_seeds": "101-130",
      "recommended_ticks": 20000,
      "primary_outcomes": [
        "numerical_stability_pass",
        "active_dynamics_pass",
        "activity_regime",
        "weight_scale",
        "drive_scale",
        "post_burn_in_mean_spikes",
        "post_burn_in_spike_cv"
      ]
    },
    {
      "id": "snn_extended_horizon_v1",
      "implementation": "src.research.stability_followups:run_stimulus_class_stability",
      "status": "EXECUTABLE_EXPLORATORY",
      "question": "Do the classified activity regimes persist substantially beyond the original 100000-tick observation horizon?",
      "conditions": ["no_input", "tonic", "rhythmic", "seeded_bounded_noise"],
      "recommended_seeds": "101-110",
      "recommended_ticks": 250000,
      "primary_outcomes": [
        "numerical_stability_pass",
        "active_dynamics_pass",
        "post_burn_in_spike_relative_drift",
        "post_burn_in_voltage_relative_drift",
        "activity_regime"
      ]
