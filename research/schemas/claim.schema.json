{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brain-5d.dev/schemas/claim.schema.json",
  "title": "Brain-5D Scientific Claim",
  "description": "Schema for a scientific claim in the claim registry.",
  "type": "object",
  "required": [
    "id",
    "claim",
    "research_question",
    "hypothesis",
    "status",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CLAIM-[A-Z]+-[0-9]{3}$"
    },
    "claim": {
      "type": "string",
      "description": "The scientific statement being made."
    },
    "research_question": {
      "type": "string",
      "pattern": "^RQ-"
    },
    "hypothesis": {
      "type": "string",
      "pattern": "^H-"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EVID-" }
    },
    "experiments": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EXP-" }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SRC-" }
    },
    "status": {
      "type": "string",
      "enum": ["untested", "inconclusive", "supported", "refuted"],
      "description": "Scientific status of the claim."
    },
    "confidence": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "very_high"]
    },
    "required_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Types of evidence required before this claim can be promoted."
    },
    "minimum_runs": {
      "type": "integer",
      "description": "Minimum number of experimental runs required."
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  }
}
