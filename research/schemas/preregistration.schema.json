{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain-5d.local/schemas/preregistration.schema.json",
  "title": "Brain-5D Scientific Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preregistration_id",
    "research_question",
    "hypothesis",
    "protocol_id",
    "mode",
    "primary_outcomes",
    "conditions",
    "seed_strategy",
    "stopping_rule",
    "inclusion_criteria",
    "exclusion_criteria",
    "analysis_plan",
    "freeze"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "preregistration_id": {"type": "string", "pattern": "^PREREG-[A-Z0-9-]+$"},
    "research_question": {"type": "string", "pattern": "^RQ-"},
    "hypothesis": {"type": "string", "pattern": "^H-"},
    "protocol_id": {"type": "string", "minLength": 3},
    "mode": {"enum": ["EXPLORATORY", "CONFIRMATORY", "REPLICATION"]},
    "primary_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "secondary_outcomes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"},
      "default": []
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["control", "treatment", "sham", "comparison"]}
        }
      }
    },
    "seed_strategy": {
      "type": "object",
      "required": ["minimum_independent_seeds", "rule"],
      "properties": {
        "minimum_independent_seeds": {"type": "integer", "minimum": 1, "maximum": 10000},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "stopping_rule": {"type": "string", "minLength": 1},
    "inclusion_criteria": {"type": "array", "items": {"type": "string"}},
    "exclusion_criteria": {"type": "array", "items": {"type": "string"}},
    "analysis_plan": {
      "type": "object",
      "required": ["descriptive_statistics", "inference_policy"],
      "properties": {
        "descriptive_statistics": {"type": "array", "items": {"type": "string"}},
        "inference_policy": {"type": "string", "minLength": 1},
        "planned_tests": {"type": "array", "items": {"type": "string"}}
      }
    },
    "expected_failure_modes": {"type": "array", "items": {"type": "string"}},
    "ai_treatment": {
      "type": "object",
      "properties": {
        "role": {"enum": ["none", "interpretation_only", "treatment"]},
        "authority_boundary": {"type": "string"},
        "prompt_digest_required": {"type": "boolean"}
      }
    },
    "freeze": {
      "type": "object",
      "required": ["immutable_after_first_run", "human_review_required", "status"],
      "properties": {
        "immutable_after_first_run": {"const": true},
        "human_review_required": {"const": true},
        "status": {"enum": ["REGISTERED", "FROZEN", "AMENDED"]},
        "amendment_id": {"type": ["string", "null"]}
      }
    }
  }
}
