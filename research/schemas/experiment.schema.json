{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brain-5d.dev/schemas/experiment.schema.json",
  "title": "Brain-5D Experiment Manifest",
  "description": "Schema for Brain-5D experiment manifests. Captures all metadata needed for reproducibility.",
  "type": "object",
  "required": [
    "experiment_id",
    "timestamp",
    "git",
    "simulation",
    "artifacts"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-(DET|SNN|STDP|HOM|STRUCT|5D|MEM|STOR|SCALE|ROB|EMB|LLM|ETH|GEN)-[0-9]{4}$",
      "description": "Unique experiment identifier following the convention EXP-{TYPE}-{NNNN}."
    },
    "experiment_status": {
      "type": "string",
      "enum": ["template", "not_started", "running", "completed", "failed", "invalid"],
      "description": "Execution status of the experiment."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of experiment start."
    },
    "research_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RQ-[A-Z]+-[0-9]{3}$"
      },
      "description": "List of research questions this experiment addresses."
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^H-[A-Z]+-[0-9]{3}-[A-Z]$"
      },
      "description": "List of hypotheses this experiment tests."
    },
    "git": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "type": "string",
          "description": "Git commit hash of the codebase at experiment time."
        },
        "dirty": {
          "type": "boolean",
          "description": "Whether the working tree had uncommitted changes."
        },
        "branch": {
          "type": "string",
          "description": "Current git branch."
        }
      }
    },
    "software": {
      "type": "object",
      "properties": {
        "brain5d_version": {
          "type": "string",
          "description": "Brain-5D software version."
        },
        "python": {
          "type": "string",
          "description": "Python version used."
        },
        "os": {
          "type": "string",
          "description": "Operating system."
        },
        "hardware": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "ram_gb": { "type": "number" },
            "gpu": { "type": "string" }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "required": ["seed", "ticks"],
      "properties": {
        "seed": {
          "type": "integer",
          "description": "Random seed for reproducibility."
        },
        "ticks": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of simulation ticks."
        },
        "dimensions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "Network dimensions, e.g. [10,10,10,10,10]."
        },
        "neurons_initial": {
          "type": "integer",
          "description": "Initial neuron count."
        },
        "neurons_final": {
          "type": "integer",
          "description": "Final neuron count (if structural plasticity)."
        },
        "synapses_initial": {
          "type": "integer",
          "description": "Initial synapse count."
        },
        "synapses_final": {
          "type": "integer",
          "description": "Final synapse count."
        },
        "learning": {
          "type": "boolean",
          "description": "Whether learning (STDP) was enabled."
        },
        "homeostasis": {
          "type": "boolean",
          "description": "Whether homeostasis was enabled."
        },
        "structural_plasticity": {
          "type": "boolean",
          "description": "Whether structural plasticity was enabled."
        },
        "neuron_model": {
          "type": "string",
          "description": "Neuron model used (e.g. izhikevich, lif)."
        },
        "integrator": {
          "type": "string",
          "description": "Numerical integrator used."
        },
        "stdp_params": {
          "type": "object",
          "description": "STDP parameters (A_plus, A_minus, tau_plus, tau_minus, etc.)."
        },
        "homeostasis_params": {
          "type": "object",
          "description": "Homeostasis parameters."
        },
        "structural_params": {
          "type": "object",
          "description": "Structural plasticity parameters."
        },
        "input_pattern": {
          "type": "string",
          "description": "Description of the input stimulus pattern."
        }
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "metrics_summary": {
          "type": "object",
          "description": "Key result metrics from the experiment."
        },
        "exceptions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Any exceptions or warnings during the run."
        }
      }
    },
    "data_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DATA-" },
      "description": "References to DATA-* measurement artifacts produced by this experiment."
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "snapshot": {
          "type": "string",
          "description": "Path to the final state snapshot (.b5d)."
        },
        "metrics": {
          "type": "string",
          "description": "Path to the metrics CSV file."
        },
        "config": {
          "type": "string",
          "description": "Path to the configuration YAML used."
        },
        "logs": {
          "type": "string",
          "description": "Path to the log file."
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": "number",
          "description": "Wall-clock duration of the experiment."
        },
        "ram_peak_mb": {
          "type": "number",
          "description": "Peak RAM usage in MB."
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVID-[0-9]{4}-[0-9]{2}$"
      },
      "description": "Evidence IDs generated from this experiment."
    },
    "test_status": {
      "type": "string",
      "enum": ["passed", "failed", "inconclusive", "error"],
      "description": "Overall test status of the experiment."
    }
  }
}
