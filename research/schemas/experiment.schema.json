{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brain-5d.dev/schemas/experiment.schema.json",
  "title": "Brain-5D Experiment Manifest",
  "description": "Schema for Brain-5D experiment manifests. Captures all metadata needed for reproducibility.",
  "type": "object",
  "required": ["experiment_id", "timestamp", "git", "simulation", "artifacts"],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{4}(?:-v[0-9]+)?$",
      "description": "Unique experiment identifier following an extensible EXP-* convention."
    },
    "experiment_status": {
      "type": "string",
      "enum": ["template", "not_started", "running", "completed", "failed", "invalid"],
      "description": "Execution status of the experiment."
    },
    "timestamp": {"type": "string", "format": "date-time", "description": "ISO 8601 timestamp of experiment start."},
    "research_questions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^RQ-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
      "description": "List of research questions this experiment addresses."
    },
    "hypotheses": {
      "type": "array",
      "items": {"type": "string", "pattern": "^H-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
      "description": "List of hypotheses this experiment tests."
    },
    "git": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "description": "Git commit hash of the codebase at experiment time."},
        "dirty": {"type": "boolean", "description": "Whether the working tree had uncommitted changes."},
        "branch": {"type": "string", "description": "Current git branch."}
      }
    },
    "software": {
      "type": "object",
      "properties": {
        "brain5d_version": {"type": "string"},
        "python": {"type": "string"},
        "os": {"type": "string"},
        "hardware": {
          "type": "object",
          "properties": {
            "cpu": {"type": "string"},
            "ram_gb": {"type": "number"},
            "gpu": {"type": "string"}
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "required": ["seed", "ticks"],
      "properties": {
        "seed": {"type": "integer", "description": "Random seed for reproducibility."},
        "ticks": {"type": "integer", "minimum": 1, "description": "Number of simulation ticks."},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "integer", "minimum": 1},
          "description": "Configured dimensional shape. Productive legacy SNN snapshots currently persist exactly five core coordinates; external/MSBA projection spaces may use 1-32 dimensions."
        },
        "projection_dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Dimension count of a non-core projection/adaptor space."
        },
        "neurons_initial": {"type": "integer"},
        "neurons_final": {"type": "integer"},
        "synapses_initial": {"type": "integer"},
        "synapses_final": {"type": "integer"},
        "learning": {"type": "boolean"},
        "homeostasis": {"type": "boolean"},
        "structural_plasticity": {"type": "boolean"},
        "neuron_model": {"type": "string"},
        "integrator": {"type": "string"},
        "stdp_params": {"type": "object"},
        "homeostasis_params": {"type": "object"},
        "structural_params": {"type": "object"},
        "input_pattern": {"type": "string"}
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "metrics_summary": {"type": "object"},
        "exceptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "data_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^DATA-"},
      "description": "References to DATA-* measurement artifacts produced by this experiment."
    },
    "artifacts": {"type": "object"},
    "runtime": {
      "type": "object",
      "properties": {
        "duration_seconds": {"type": "number"},
        "ram_peak_mb": {"type": "number"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EVID-[0-9]{4}-[0-9]{2}$"}
    },
    "test_status": {
      "type": "string",
      "enum": ["passed", "failed", "inconclusive", "error"]
    }
  }
}
