{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brain-5d.dev/schemas/evidence.schema.json",
  "title": "Brain-5D Evidence Entry",
  "description": "Schema for a single evidence entry generated from an experiment.",
  "type": "object",
  "required": [
    "evidence_id",
    "experiment_id",
    "claim_id",
    "result_summary",
    "effect_size",
    "status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EVID-[0-9]{4}-[0-9]{2}$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CLAIM-"
    },
    "hypothesis_id": {
      "type": "string",
      "pattern": "^H-"
    },
    "result_summary": {
      "type": "string",
      "description": "Plain-text summary of the experimental result."
    },
    "effect_size": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "metric": { "type": "string" },
        "confidence_interval": {
          "type": "object",
          "properties": {
            "lower": { "type": "number" },
            "upper": { "type": "number" },
            "level": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      },
      "required": ["value", "metric"]
    },
    "statistical_significance": {
      "type": "object",
      "properties": {
        "p_value": { "type": "number" },
        "test": { "type": "string" },
        "n_runs": { "type": "integer" }
      }
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "deterministic_verification",
        "stochastic_experiment",
        "observational_experiment"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "conditions": { "type": "integer", "minimum": 1 },
        "repeated_evaluations_per_condition": { "type": "integer", "minimum": 1 },
        "independent_runs": { "type": "integer", "minimum": 0 },
        "sign_compliance": { "type": "number", "minimum": 0, "maximum": 1 },
        "deterministic_identity": { "type": "boolean" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["supports", "refutes", "inconclusive", "pending"],
      "description": "Whether this evidence supports or refutes the claim."
    },
    "limitations": {
      "type": "string",
      "description": "Known limitations of this evidence."
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "figures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    }
  }
}
